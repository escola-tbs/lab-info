{
  "entities": {
    "Reservation": {
      "title": "Reservation",
      "description": "A reservation for the school computer lab, Chromebooks, or both",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique reservation identifier"
        },
        "userId": {
          "type": "string",
          "description": "Firebase Auth UID of the user who booked"
        },
        "userName": {
          "type": "string",
          "description": "Full name of the reserving teacher or PIBID fellow",
          "maxLength": 100
        },
        "date": {
          "type": "string",
          "description": "Date of reservation in YYYY-MM-DD format",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "period": {
          "type": "string",
          "description": "School shift: manha or tarde",
          "enum": ["manha", "tarde"]
        },
        "slots": {
          "type": "array",
          "description": "List of reserved slot IDs, e.g. m1, m2, t1"
        },
        "resource": {
          "type": "string",
          "description": "Resource type booked",
          "enum": ["both", "lab", "chromebooks"]
        },
        "purpose": {
          "type": "string",
          "description": "Pedagogical or administrative purpose of the reservation",
          "maxLength": 500
        },
        "status": {
          "type": "string",
          "description": "Reservation status",
          "enum": ["pendente", "confirmada", "cancelada"]
        },
        "createdAt": {
          "type": "string",
          "description": "Timestamp when reservation was made"
        },
        "updatedAt": {
          "type": "string",
          "description": "Timestamp when reservation was last updated"
        }
      },
      "required": ["id", "userId", "userName", "date", "period", "slots", "resource", "purpose", "status"]
    },
    "SlotLock": {
      "title": "SlotLock",
      "description": "Atomic tracking of lab and chromebook occupancy per slot key",
      "type": "object",
      "properties": {
        "date": {
          "type": "string",
          "description": "Date in YYYY-MM-DD format"
        },
        "slotId": {
          "type": "string",
          "description": "Slot identifier (e.g. m1, m2, t1)"
        },
        "labReservationId": {
          "type": "string",
          "description": "ID of reservation holding the physical lab, or empty if free"
        },
        "chromebooksReservationId": {
          "type": "string",
          "description": "ID of reservation holding the Chromebooks, or empty if free"
        },
        "updatedAt": {
          "type": "string",
          "description": "Last update timestamp"
        }
      },
      "required": ["date", "slotId"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "Private user account profile",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "User UID matching auth.uid"
        },
        "displayName": {
          "type": "string",
          "description": "Full name of the user",
          "maxLength": 100
        },
        "email": {
          "type": "string",
          "description": "Google account email"
        },
        "whatsapp": {
          "type": "string",
          "description": "WhatsApp phone number in standard 55DDD9XXXXXXXX format",
          "maxLength": 20
        },
        "role": {
          "type": "string",
          "description": "Role in the system",
          "enum": ["user", "admin"]
        },
        "createdAt": {
          "type": "string",
          "description": "Creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "description": "Last update timestamp"
        }
      },
      "required": ["uid", "displayName", "whatsapp"]
    },
    "UserContact": {
      "title": "UserContact",
      "description": "Public contact card for authenticated users to negotiate slots via WhatsApp",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "User UID matching auth.uid"
        },
        "displayName": {
          "type": "string",
          "description": "Full name of the user",
          "maxLength": 100
        },
        "whatsapp": {
          "type": "string",
          "description": "Standardized WhatsApp number (55 + DDD + 9 digits)",
          "maxLength": 20
        },
        "updatedAt": {
          "type": "string",
          "description": "Last update timestamp"
        }
      },
      "required": ["uid", "displayName", "whatsapp"]
    },
    "SystemSettings": {
      "title": "SystemSettings",
      "description": "Global school lab configuration",
      "type": "object",
      "properties": {
        "accessPassword": {
          "type": "string",
          "description": "Access password required to create new reservations (default: tbs2026)",
          "maxLength": 50
        },
        "requireAdminApproval": {
          "type": "boolean",
          "description": "Whether reservations require admin approval before confirmation (default: false)"
        },
        "adminEmails": {
          "type": "array",
          "description": "List of authorized administrator email addresses"
        },
        "updatedAt": {
          "type": "string",
          "description": "Last update timestamp"
        },
        "updatedBy": {
          "type": "string",
          "description": "Admin UID who made update"
        }
      },
      "required": ["accessPassword", "requireAdminApproval", "adminEmails"]
    },
    "Admin": {
      "title": "Admin",
      "description": "Admin registration document",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "description": "Administrator email address"
        },
        "addedAt": {
          "type": "string",
          "description": "Timestamp when added as admin"
        },
        "addedBy": {
          "type": "string",
          "description": "Email or UID of admin who authorized"
        }
      },
      "required": ["email"]
    }
  },
  "firestore": {
    "/reservations/{reservationId}": {
      "schema": {
        "$ref": "#/entities/Reservation"
      },
      "description": "Publicly readable agenda reservations, protected writes"
    },
    "/slot_locks/{slotLockId}": {
      "schema": {
        "$ref": "#/entities/SlotLock"
      },
      "description": "Atomic tracking locks for lab and chromebook availability per slot"
    },
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/UserProfile"
      },
      "description": "Private profile of the authenticated user"
    },
    "/user_contacts/{userId}": {
      "schema": {
        "$ref": "#/entities/UserContact"
      },
      "description": "Contact info visible strictly to signed-in users for schedule negotiation"
    },
    "/system_settings/config": {
      "schema": {
        "$ref": "#/entities/SystemSettings"
      },
      "description": "Global app settings including access password and admin emails"
    },
    "/admins/{adminId}": {
      "schema": {
        "$ref": "#/entities/Admin"
      },
      "description": "List of authorized administrator accounts"
    }
  }
}
