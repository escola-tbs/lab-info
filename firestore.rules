rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function hasAdminEmail() {
      return isSignedIn() &&
        'email' in request.auth.token &&
        request.auth.token.email != null &&
        (
          request.auth.token.email in [
            'marcio.magalhaes.432@gmail.com'
          ] ||
          (
            exists(/databases/$(database)/documents/system_settings/config) &&
            'adminEmails' in get(/databases/$(database)/documents/system_settings/config).data &&
            request.auth.token.email in get(/databases/$(database)/documents/system_settings/config).data.adminEmails
          )
        );
    }

    function isAdmin() {
      return isSignedIn() && (
        hasAdminEmail() ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Reservations Collection - Public read for agenda, authenticated writes
    match /reservations/{reservationId} {
      allow read: if true;

      allow create: if isSignedIn()
        && isValidId(reservationId)
        && incoming().id == reservationId
        && (isAdmin() || incoming().userId == request.auth.uid)
        && incoming().userName is string && incoming().userName.size() > 0 && incoming().userName.size() <= 100
        && incoming().date is string && incoming().date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && incoming().period in ['manha', 'tarde']
        && incoming().slots is list && incoming().slots.size() > 0 && incoming().slots.size() <= 10
        && incoming().resource in ['both', 'lab', 'chromebooks']
        && incoming().purpose is string && incoming().purpose.size() > 0 && incoming().purpose.size() <= 500
        && incoming().status in ['pendente', 'confirmada']
        && incoming().keys().hasAll(['id', 'userId', 'userName', 'date', 'period', 'slots', 'resource', 'purpose', 'status']);

      allow update: if isSignedIn() && (
        isAdmin() ||
        (
          existing().userId == request.auth.uid &&
          incoming().userId == existing().userId &&
          incoming().id == existing().id &&
          (
            // Action 1: Cancel
            (incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']) && incoming().status == 'cancelada')
            // Action 2: Edit
            || (incoming().diff(existing()).affectedKeys().hasOnly(['userName', 'date', 'period', 'slots', 'resource', 'purpose', 'status', 'updatedAt']) && incoming().status in ['pendente', 'confirmada'])
          )
        )
      );

      allow delete: if isAdmin();
    }

    // Slot Locks Collection - Public read, authenticated sync
    match /slot_locks/{slotLockId} {
      allow read: if true;
      allow write: if isSignedIn() && isValidId(slotLockId);
    }

    // User Private Profile - Restricted to owner and admin
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId) || isAdmin();
    }

    // User Public Contact Card - Restricted to signed-in users (protects WhatsApp from visitors)
    match /user_contacts/{userId} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId) || isAdmin();
    }

    // System Settings - Public read for app rules, admin write
    match /system_settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Admins Collection - Signed-in read, admin write
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
